# Telegram Quiz Bot — Configuration Template (.env.example)
# Copy to .env for local use or set in Railway -> Variables.
# NEVER commit real tokens or secrets to git.

# Required: Telegram Bot Token from @BotFather
BOT_TOKEN=

# Optional: Persistent data directory (Railway sets RAILWAY_VOLUME_MOUNT_PATH automatically)
DATA_DIR=
DB_PATH=

# Required Telegram Group Join Gate (@username or -100... chat ID; empty disables gate)
REQUIRED_CHAT=@kalam_kranti
REQUIRED_CHAT_URL=https://t.me/kalam_kranti
MEMBERSHIP_RECHECK_SECONDS=600

# Support group/channel notified once when a new user first sends /start
SUPPORT_NOTIFY_CHAT=@DAUSA_123

# Question tag prepended once to every question
QUESTION_TAG=जय श्री श्याम

# Quiz timer defaults (seconds per question)
DEFAULT_TIMER=45
GROUP_DEFAULT_TIMER=45
GROUP_NEXT_DELAY=2.0

# Complete Quiz Review PDF settings
REVIEW_PDF_ENABLED=1
REVIEW_PDF_PRIVATE_AUTO=1
REVIEW_PDF_GROUP_AUTO=1
REVIEW_PDF_RETRIES=3
WATERMARK_OPACITY=0.102

# HTML Import settings
HTML_IMPORT_ADMIN_ONLY=0
HTML_MAX_BYTES=12582912
HTML_MAX_NODES=400000

# Automatic JSON Backup & Optional Private GitHub Sync
BACKUP_ENABLED=1
BACKUP_ADMIN_IDS=
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BACKUP_PATH=quiz_backup.json
GITHUB_BRANCH=

# Owner / Admin / Community & Error Logging (optional)
OWNER_ID=
ADMIN_IDS=
REQUIRED_SUB_CHANNEL=
# Chat ID or @username that receives sanitized error alerts (empty = disabled)
LOG_GROUP=
# DISPLAY-ONLY references shown on /admin. They do NOT change the join gate
# (REQUIRED_CHAT), the PDF footer link or any user-facing link.
BOT_GROUP=
CHANNEL_ID=
# NOTE: FREE_BOT is NOT supported (ignored with a startup warning). Every quiz is
# free; there are no paid plans or payments. A quiz owner can only restrict WHO may
# play a quiz (batch / private / authorized groups) with /access.

# OpenRouter AI Question Generation (optional; secrets loaded from env only)
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_KEYS=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional automatic HTML report delivery alongside Review PDF (0 = on-demand via /htmlreport)
AUTO_HTML_REPORT=0

