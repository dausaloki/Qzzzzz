# Telegram Quiz Bot — Configuration Template (.env.example)
# Copy to .env for local use or set in Railway -> Variables.
# NEVER commit real tokens or secrets to git.

# Required: Telegram Bot Token from @BotFather
BOT_TOKEN=

# Optional: Persistent data directory (Railway sets RAILWAY_VOLUME_MOUNT_PATH automatically)
DATA_DIR=
DB_PATH=

# Required Telegram Group Join Gate (@username or -100... chat ID; empty disables gate)
REQUIRED_CHAT=@kalam_kranti
REQUIRED_CHAT_URL=https://t.me/kalam_kranti
MEMBERSHIP_RECHECK_SECONDS=600

# Question tag prepended once to every question
QUESTION_TAG=जय श्री श्याम

# Group Quiz defaults
GROUP_DEFAULT_TIMER=30
GROUP_NEXT_DELAY=2.0

# Complete Quiz Review PDF settings
REVIEW_PDF_ENABLED=1
REVIEW_PDF_PRIVATE_AUTO=1
REVIEW_PDF_GROUP_AUTO=1
REVIEW_PDF_RETRIES=3
WATERMARK_OPACITY=0.102

# HTML Import settings
HTML_IMPORT_ADMIN_ONLY=0
HTML_MAX_BYTES=12582912
HTML_MAX_NODES=400000

# Automatic JSON Backup & Optional Private GitHub Sync
BACKUP_ENABLED=1
BACKUP_ADMIN_IDS=
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BACKUP_PATH=quiz_backup.json
GITHUB_BRANCH=
